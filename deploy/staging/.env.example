# EN: Copy to deploy/staging/.env (git ignores it) and fill in. Generate secrets with: openssl rand -hex 32
# VI: Chép thành deploy/staging/.env (git bỏ qua file này) rồi điền. Tạo secret bằng: openssl rand -hex 32

# EN: The domain whose DNS points at this server, and the email Let's Encrypt writes to about the certificate.
# VI: Domain có DNS trỏ về server này, và email Let's Encrypt dùng để báo về chứng chỉ.
NEXBID_DOMAIN=staging.example.com
NEXBID_ACME_EMAIL=you@example.com

NEXBID_DB_PASSWORD=
NEXBID_JWT_SECRET=

# EN: VNPay merchant (sandbox: https://sandbox.vnpayment.vn/devreg/). In the merchant portal set the IPN URL to
#     https://<NEXBID_DOMAIN>/api/payments/vnpay/ipn
# VI: Merchant VNPay (sandbox: https://sandbox.vnpayment.vn/devreg/). Trong trang merchant, đặt IPN URL là
#     https://<NEXBID_DOMAIN>/api/payments/vnpay/ipn
NEXBID_VNPAY_TMN_CODE=
NEXBID_VNPAY_HASH_SECRET=
# NEXBID_VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# EN: Brevo (https://app.brevo.com/settings/keys/api). The sender address must be verified in Brevo; verify the whole
#     domain (SPF and DKIM records) so emails do not land in spam. Empty key: emails are logged, not sent.
# VI: Brevo (https://app.brevo.com/settings/keys/api). Địa chỉ gửi phải được xác minh trong Brevo; nên xác minh cả domain
#     (bản ghi SPF và DKIM) để email không vào spam. Để trống key: email chỉ được ghi log, không gửi.
NEXBID_BREVO_API_KEY=
NEXBID_MAIL_SENDER_EMAIL=
NEXBID_MAIL_SENDER_NAME=NexBid

# EN: Accounts made admin at startup, comma-separated. / VI: Các tài khoản được cấp quyền admin khi khởi động, cách nhau bằng dấu phẩy.
NEXBID_ADMIN_EMAILS=
