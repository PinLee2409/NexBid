# Local settings for the backend. Copy to backend/.env (git ignores it) and fill in what you need.
# The "nexbid-backend" entry in .claude/launch.json loads backend/.env; with IntelliJ, add the same variables to the
# run configuration. Empty values are skipped, so the defaults in src/main/resources/application.yml apply.
# Sao chép thành backend/.env (git bỏ qua file đó) rồi điền những gì cần. Biến để trống thì dùng mặc định trong
# application.yml.

# --- VNPay (sandbox keys from VNPay's registration email) / Khoá sandbox trong email đăng ký VNPay ---
NEXBID_VNPAY_TMN_CODE=
NEXBID_VNPAY_HASH_SECRET=
# Where VNPay sends the buyer back. / Nơi VNPay đưa người mua quay về.
NEXBID_VNPAY_RETURN_URL=

# --- Brevo email (without a key, emails are only logged) / Không có key thì email chỉ được ghi log ---
NEXBID_BREVO_API_KEY=
# A sender address verified in Brevo. / Địa chỉ người gửi đã xác thực trong Brevo.
NEXBID_MAIL_SENDER_EMAIL=
NEXBID_MAIL_SENDER_NAME=
# Links in emails point here. / Link trong email trỏ về đây.
NEXBID_SITE_URL=

# --- Security (required in production; the prod profile refuses the development defaults) ---
# --- Bảo mật (bắt buộc ở production; profile prod từ chối giá trị mặc định) ---
NEXBID_JWT_SECRET=

# --- Database, Redis, Kafka (defaults match docker/compose.yaml) / Mặc định khớp docker/compose.yaml ---
NEXBID_DB_URL=
NEXBID_DB_USER=
NEXBID_DB_PASSWORD=
NEXBID_REDIS_HOST=
NEXBID_REDIS_PORT=
NEXBID_KAFKA_SERVERS=

# --- Accounts given a role at start-up (comma-separated emails) / Tài khoản được cấp vai trò khi khởi động ---
NEXBID_ADMIN_EMAILS=
NEXBID_SELLER_EMAILS=

# --- GHN shipping (sandbox token from https://5sao.ghn.dev) / GHN, token sandbox ---
NEXBID_GHN_TOKEN=
NEXBID_GHN_SHOP_ID=
# The webhook URL to give GHN is /api/shipping/ghn/webhook?secret=<this>. / URL webhook gửi GHN.
NEXBID_GHN_WEBHOOK_SECRET=
NEXBID_GHN_BASE_URL=
